# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# PRODUCTION MYSQL / PHPMYADMIN DATABASE CONFIGURATION
# Enter your MySQL credentials below. ParmChat will automatically create all
# tables (`users`, `chats`, `chat_participants`, `messages`, `statuses`) on boot!
# ==============================================================================
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="parmchat_db"
# Alternative single connection URI (if provided, takes precedence):
# MYSQL_URL="mysql://user:pass@host:3306/parmchat_db"

# ==============================================================================
# PRODUCTION AWS S3 & CLOUDFRONT CDN CONFIGURATION
# For storing media (photos/audio) in AWS S3 and serving via CloudFront CDN.
# If not provided, ParmChat seamlessly falls back to secure base64 E2EE data payloads.
# ==============================================================================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
# CloudFront CDN domain (e.g. https://d1234abcdef.cloudfront.net)
AWS_CLOUDFRONT_DOMAIN=""

